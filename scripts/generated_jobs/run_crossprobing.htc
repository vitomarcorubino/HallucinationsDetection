universe       = vanilla
executable     = /lustrehome/vitomarcorubino/HallucinationsDetection/scripts/run_main.sh

request_cpus   = 4
request_gpus   = 0
request_memory = 16GB

initialdir     = /lustrehome/vitomarcorubino/HallucinationsDetection
getenv         = True

log    = logs/job_$(Cluster)_crossprobe.log
output = logs/job_$(Cluster)_$(Process)_crossprobe.out
error  = logs/job_$(Cluster)_$(Process)_crossprobe.err

